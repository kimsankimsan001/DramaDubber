{
  "name": "dubify-ai-clone",
  "version": "2.5.0",
  "description": "Automated AI Movie Recap Creation, Video Dubbing, Subtitle Generation & Editing Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "backend": "venv\\Scripts\\python.exe -m backend.main",
    "electron": "electron .",
    "start": "concurrently -k \"npm run dev\" \"npm run backend\" \"cross-env NODE_ENV=development electron .\""
  },
  "keywords": [
    "dubify",
    "ai-dubbing",
    "movie-recap",
    "stt",
    "tts",
    "voice-cloning",
    "electron",
    "react",
    "ffmpeg",
    "gemini-api"
  ],
  "author": "Dubify AI",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^6.2.1"
  }
}
